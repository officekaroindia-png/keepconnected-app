{
  "expo": {
    "name": "Keep Konnected",
    "slug": "keepconnected",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#EAF2FF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karoindia.keepconnected",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel",
          "whatsapp"
        ]
      }
    },
    "android": {
      "package": "com.karoindia.keepconnected",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CALL_PHONE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#EAF2FF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f7018af4-c08c-4a2c-b3d9-6159de468a73"
      }
    }
  }
}